{
  "name": "gcommit",
  "version": "1.0.0",
  "description": "AI-powered git commit message generator",
  "bin": {
    "gcommit": "./src/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/"
  ],
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "node src/index.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "execa": "^9.6.1",
    "groq-sdk": "^1.1.2",
    "inquirer": "^13.4.1",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "eslint": "^10.2.0",
    "prettier": "^3.8.2",
    "vitest": "^4.1.4"
  }
}
