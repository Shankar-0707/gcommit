{
  "name": "@shankar07/gcommit",
  "version": "0.1.2",
  "type": "module",
  "description": "AI-powered git commit message generator using Groq",
  "bin": {
    "gcommit": "src/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/"
  ],
  "keywords": [
    "git",
    "commit",
    "ai",
    "cli",
    "conventional-commits",
    "groq",
    "llama"
  ],
  "author": "Your Name",
  "license": "MIT",
  "homepage": "https://github.com/Shankar-0707/gcommit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shankar-0707/gcommit.git"
  },
  "scripts": {
    "dev": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "chalk": "^5.0.0",
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "execa": "^9.0.0",
    "groq-sdk": "^0.9.0",
    "inquirer": "^8.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "vitest": "^2.0.0"
  }
}
